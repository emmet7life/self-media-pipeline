#!/usr/bin/env python3
"""
draft-spec —— 把"用户的自然语言输入"解析成机器可读的 spec.yaml

本工具是 self-media-pipeline Step 1 的 CLI 版。
它本身**不**调 LLM——只做简单的关键字解析。
真实场景下，orchestrator agent 加载 self-media-pipeline/SKILL.md 后，
自己用 LLM 解析用户输入到 spec.yaml；本工具给"非 LLM 场景"和"调试"用。

用法:
    python tools/draft-spec --topic "AI Agent 入门" --platforms wechat,xiaohongshu
    python tools/draft-spec --topic "..." --platforms wechat --word-count 800 --source https://...
"""
import argparse
import json
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "tools"))

from _catalog import (  # noqa: E402
    active_platform_ids,
    list_platforms,
    parse_template_selection,
    platform_defaults,
    resolve_template_selection,
)


def build_spec(args: argparse.Namespace) -> dict:
    platforms = [p.strip() for p in args.platforms.split(",") if p.strip()]
    active = active_platform_ids()
    unknown = [p for p in platforms if p not in active]
    if unknown:
        print(f"ERROR: unknown or inactive platform(s): {unknown}; active: {active}", file=sys.stderr)
        planned = [p["id"] for p in list_platforms(include_planned=True) if p["status"] == "planned"]
        if planned:
            print(f"INFO: planned but not selectable yet: {planned}", file=sys.stderr)
        sys.exit(1)

    try:
        explicit_templates = parse_template_selection(args.templates)
        template_selection = resolve_template_selection(platforms, explicit_templates)
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        sys.exit(1)

    spec = {
        "topic": args.topic,
        "target_platforms": platforms,
        "template_selection": template_selection,
        "source_material": args.source,
        "style_reference": args.style_reference,
        "word_count_target": args.word_count,
        "constraints": {p: platform_defaults(p) for p in platforms},
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    return spec


def main() -> None:
    ap = argparse.ArgumentParser(description="Generate pipeline spec from user input")
    ap.add_argument("--topic", required=True)
    ap.add_argument("--platforms", default="wechat,xiaohongshu", help="comma-separated")
    ap.add_argument(
        "--templates",
        help="comma-separated platform=template-id mappings, e.g. wechat=wechat-magazine-editorial",
    )
    ap.add_argument("--source", help="source material (URL or path)")
    ap.add_argument("--style-reference", help="style reference article id or description")
    ap.add_argument("--word-count", type=int, help="target word count")
    ap.add_argument("--out", help="output path; default stdout; if dir, auto-name with timestamp")
    args = ap.parse_args()

    spec = build_spec(args)
    yaml_text = json.dumps(spec, ensure_ascii=False, indent=2)  # 暂用 JSON, YAML 库第 1-2 周不引

    if args.out:
        out = Path(args.out)
        # 情况 1: --out 是目录 → 在目录下生成带时间戳的文件
        if out.is_dir():
            ts = time.strftime("%Y%m%d-%H%M%S", time.gmtime())
            out = out / f"spec-{ts}.json"
        # 情况 2: --out 是文件路径（不一定存在）→ 写入该路径
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(yaml_text, encoding="utf-8")
        print(f"wrote {out}", file=sys.stderr)
    else:
        print(yaml_text)


if __name__ == "__main__":
    main()
