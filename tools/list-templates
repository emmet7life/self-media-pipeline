#!/usr/bin/env python3
from __future__ import annotations

"""List self-media-pipeline visual templates."""

import argparse
import json
import sys

from _catalog import list_templates, validate_catalog


def main() -> None:
    ap = argparse.ArgumentParser(description="List reusable self-media visual templates")
    ap.add_argument("--platform", help="filter templates by platform id")
    ap.add_argument("--json", action="store_true", help="emit JSON")
    ap.add_argument("--include-inactive", action="store_true", help="include inactive templates")
    ap.add_argument("--validate", action="store_true", help="validate platform/template catalog")
    args = ap.parse_args()

    if args.validate:
        issues = validate_catalog()
        if args.json:
            json.dump({"pass": not issues, "issues": issues}, sys.stdout, ensure_ascii=False, indent=2)
            sys.stdout.write("\n")
        elif issues:
            for issue in issues:
                print(f"ERROR: {issue}", file=sys.stderr)
        else:
            print("catalog OK")
        if issues:
            sys.exit(1)
        return

    rows = list_templates(platform=args.platform, include_inactive=args.include_inactive)

    if args.json:
        json.dump(rows, sys.stdout, ensure_ascii=False, indent=2)
        sys.stdout.write("\n")
        return

    if not rows:
        print("(no templates)")
        return
    print(f"{'ID':<28} {'PLATFORM':<14} {'DEFAULT':<8} {'EXAMPLE':<8} DESCRIPTION")
    print("-" * 112)
    for row in rows:
        default = "yes" if row["default"] else "no"
        example = "yes" if row["has_example"] else "no"
        print(f"{row['id']:<28} {row['platform']:<14} {default:<8} {example:<8} {row['description']}")


if __name__ == "__main__":
    main()
