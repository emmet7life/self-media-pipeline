#!/usr/bin/env python3
"""
list-targets —— 列出所有已支持的目标平台及其状态

用法:
    python tools/list-targets              # 人类可读
    python tools/list-targets --json       # JSON

输出每个目标的:
- id           平台 id
- skill 目录    对应 skill
- status       active / stub / planned
- constraints  路径
- 备注
"""
import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

TARGETS = [
    {
        "id": "wechat",
        "name": "微信公众号",
        "skill_dir": "skills/platform-wechat",
        "constraints": "skills/platform-wechat/constraints.json",
        "status": "active",
        "tools_implemented": [
            "skills/platform-wechat/tools/adapt_html.py",
            "skills/platform-wechat/tools/check_constraints.py",
