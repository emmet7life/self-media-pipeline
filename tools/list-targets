    },
]


def main() -> None:
    ap = argparse.ArgumentParser()
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    if args.json:
        json.dump(TARGETS, sys.stdout, ensure_ascii=False, indent=2)
        sys.stdout.write("\n")
        return

    print(f"{'ID':<14} {'NAME':<14} {'STATUS':<10} {'NOTE'}")
    print("-" * 70)
    for t in TARGETS:
        print(f"{t['id']:<14} {t['name']:<14} {t['status']:<10} {t['note']}")


if __name__ == "__main__":
    main()
