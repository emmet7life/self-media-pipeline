#!/usr/bin/env python3
from __future__ import annotations

"""List supported publishing targets and their selectable status."""

import argparse
import json
import sys

from _catalog import list_platforms


def main() -> None:
    ap = argparse.ArgumentParser(description="List self-media-pipeline platform targets")
    ap.add_argument("--json", action="store_true", help="emit JSON")
    ap.add_argument("--active-only", action="store_true", help="only show active/selectable targets")
    args = ap.parse_args()

    rows = list_platforms(include_planned=not args.active_only)

    if args.json:
        json.dump(rows, sys.stdout, ensure_ascii=False, indent=2)
        sys.stdout.write("\n")
        return

    print(f"{'ID':<14} {'NAME':<14} {'STATUS':<10} {'SELECTABLE':<10} NOTE")
    print("-" * 86)
    for row in rows:
        selectable = "yes" if row.get("selectable") else "no"
        print(f"{row['id']:<14} {row['name']:<14} {row['status']:<10} {selectable:<10} {row.get('note', '')}")


if __name__ == "__main__":
    main()
