        "note": "全部工具实现完成",
    },
    {
        "id": "xiaohongshu",
        "name": "小红书",
        "skill_dir": "skills/platform-xiaohongshu",
        "constraints": "skills/platform-xiaohongshu/constraints.json",
        "status": "active",
        "tools_implemented": [
            "skills/platform-xiaohongshu/tools/adapt_html.py",
            "skills/platform-xiaohongshu/tools/check_constraints.py",
